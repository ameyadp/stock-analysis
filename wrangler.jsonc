{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "stock-analysis",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	// Only reachable through ameyapurandare.com/projects/stock-analysis/app/,
	// which forwards to this Worker via a service binding.
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		// Every request goes through the Worker, which strips the URL prefix (see worker/base.ts).
		"run_worker_first": true
	},
	// Anonymous, opt-in usage counts (same scheme as the Finance Tracker).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "stock-analysis-telemetry",
			"database_id": "76fbfd55-b1ea-463c-9b64-7610e42127d6",
			"migrations_dir": "migrations"
		}
	],
	// Limits how fast one visitor can send requests through the data relay.
	"ratelimits": [
		{
			"name": "LOOKUP_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 20, "period": 60 }
		}
	]
	// No API keys are stored here: each visitor supplies their own Tiingo and FRED
	// keys, which the Worker forwards to the provider and never stores or logs.
}
