{
  "name": "stock-analysis",
  "private": true,
  "version": "0.3.1",
  "description": "How a stock behaves across Fed rate cycles and the macro economy",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply stock-analysis-telemetry --remote",
    "stats": "node scripts/stats.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^27.0.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  }
}
